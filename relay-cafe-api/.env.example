DATABASE_URL=postgres://user:pass@localhost:5432/relaycafe
GCP_PROJECT_ID=your-gcp-project-id
GCP_KMS_LOCATION=global
GCP_KMS_KEY_RING=relay-cafe
GCP_KMS_KEY_NAME=message-key
GOOGLE_APPLICATION_CREDENTIALS=./gcp-credentials.json
APPLE_BUNDLE_ID=cafe.relay.app
SESSION_SALT=change-me-32-chars-minimum
APPLE_ID_SALT=change-me-32-chars-minimum
# Message TTL in seconds. Default 86400 (24h). Set to 60 for rapid local testing.
MESSAGE_TTL_SECONDS=86400
# Token period in seconds. Default 86400 (daily at midnight UTC). Set to 300 for rapid testing.
TOKEN_PERIOD_SECONDS=86400
# Optional: Sentry DSN for error tracking. Leave empty to disable.
SENTRY_DSN=
# Redis for rate limiting. Leave empty to use in-memory fallback.
# For local dev with docker-compose: REDIS_URL=redis://localhost:6379
REDIS_URL=
# Redis command timeout in ms. If a Redis call hangs longer, it's aborted and the request proceeds without rate limiting.
REDIS_TIMEOUT_MS=2000
